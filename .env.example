APP_NAME=Lease Deal Room
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/lease_deal_room

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lease_chunks

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM / Embeddings (OpenRouter by default; swap to OpenAI/Anthropic via env only)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIMENSIONS=2048

# Optional fallback when switching directly to OpenAI
OPENAI_API_KEY=

# Local file storage & concurrency
STORAGE_DIR=./storage
EXTRACTION_CONCURRENCY=5