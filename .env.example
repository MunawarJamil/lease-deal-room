APP_NAME=Lease Deal Room
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/lease_deal_room

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lease_chunks

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM / Embeddings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Local file storage & concurrency
STORAGE_DIR=./storage
EXTRACTION_CONCURRENCY=5